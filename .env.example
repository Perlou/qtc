# Tushare Pro token（可选）：https://tushare.pro/register
TUSHARE_TOKEN=your_tushare_token_here

# 设为 1 时强制使用离线合成数据（无网络 / 数据源不可用时）
QTC_OFFLINE=0

# 加密货币交易所（Phase 1 只用公开行情接口，无需 key）
CCXT_EXCHANGE=okx
# 访问海外交易所需要代理时填写，例如 http://127.0.0.1:7890
HTTPS_PROXY=

# LLM（Phase 10 使用）
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
